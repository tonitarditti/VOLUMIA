#!/bin/sh

set -eu

max_bytes=$((50 * 1024 * 1024))
blocked=0
staged_paths_file=$(mktemp)
trap 'rm -f "$staged_paths_file"' EXIT

git diff --cached --name-only --diff-filter=ACMR >"$staged_paths_file"

while IFS= read -r path
do
  [ -n "$path" ] || continue

  case "$path" in
    .tmp-edge-palette|.tmp-edge-palette/*|*/.tmp-edge-palette/*)
      printf >&2 'Blocked: %s is inside .tmp-edge-palette/ and must stay out of git.\n' "$path"
      blocked=1
      ;;
    *.safetensors|*.ckpt|*.onnx|*.ort|*.pt|*.pth|*.bin|*.gguf)
      printf >&2 'Blocked: %s matches a model/cache file extension that must stay outside the repo.\n' "$path"
      blocked=1
      ;;
  esac

  size=$(git cat-file -s ":$path" 2>/dev/null || printf '0')
  if [ "$size" -gt "$max_bytes" ]; then
    size_mb=$(awk "BEGIN { printf \"%.2f\", $size / 1048576 }")
    printf >&2 'Blocked: %s is %s MiB staged; the limit is 50 MiB.\n' "$path" "$size_mb"
    blocked=1
  fi
done <"$staged_paths_file"

if [ "$blocked" -ne 0 ]; then
  printf >&2 '\nCommit aborted. Keep models, caches, and large generated files outside the repository.\n'
  exit 1
fi
