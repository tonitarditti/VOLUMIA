{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "VOLUMIA: Vite (Renderer)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/desktop",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "react"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "VOLUMIA: Electron (Main)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/desktop",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "electron"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "VOLUMIA: Dev (Vite + Electron)",
      "configurations": ["VOLUMIA: Vite (Renderer)", "VOLUMIA: Electron (Main)"],
      "stopAll": true
    }
  ]
}
