{
  "name": "volumia-desktop",
  "version": "0.1.0",
  "description": "VOLUMIA - Your Creative 3D Assistant Desktop App",
  "main": "electron-dist/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently -k \"npm run react\" \"npm run electron:dev\"",
    "react": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "electron:build": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:build && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron ./electron-dist/main.js",
    "electron": "electron ./electron-dist/main.js",
    "build": "vite build && npm run electron:build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "lucide-react": "^0.469.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.volumia.assistant",
    "productName": "VOLUMIA",
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "public"
    }
  }
}
